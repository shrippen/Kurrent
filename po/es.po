msgstr "Fondo desenfocado"

msgid "Use Plasma’s translucent background so KWin blurs the wallpaper. Also applies to the panel flyout."
msgstr "Usa el fondo translúcido de Plasma para que KWin desenfogue el fondo. También aplica al desplegable del panel."

msgid "Sidebar row size"
msgstr "Tamaño de filas de la barra lateral"

msgid "Auto (compact, larger with touch)"
msgstr "Automático (compacto, más grande con tacto)"

msgid "Compact"
msgstr "Compacto"

msgid "Comfortable (touch-friendly)"
msgstr "Cómodo (táctil)"

msgid "Auto uses compact rows on mouse/desktop and comfortable rows when Plasma detects tablet or touch input."
msgstr "Automático usa filas compactas con ratón y filas cómodas si Plasma detecta tableta o tacto."

msgid "New tasks"
msgstr "Tareas nuevas"

msgid "Ask which project to use"
msgstr "Preguntar qué proyecto usar"

msgid "Use the top project in the sidebar"
msgstr "Usar el primer proyecto de la barra lateral"

msgid "Use a specific project"
msgstr "Usar un proyecto concreto"

msgid "When no project is selected in the sidebar, new tasks follow this setting."
msgstr "Si no hay un proyecto seleccionado en la barra lateral, las tareas nuevas siguen esta opción."

