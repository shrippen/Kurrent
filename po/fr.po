msgstr "Tout activer"

msgid "Show All"
msgstr "Tout afficher"

msgid "Refresh"
msgstr "Actualiser"

msgid "Akonadi"
msgstr "Akonadi"

msgid "Tasks are loaded from your existing Akonadi setup."
msgstr "Les tâches sont chargées depuis votre configuration Akonadi."

msgid "Setup"
msgstr "Configuration"

msgid "Configure CalDAV/Nextcloud in KOrganizer or Kalendar (DAV groupware resource)."
msgstr "Configurez CalDAV/Nextcloud dans KOrganizer ou Kalendar (ressource DAV)."

