msgstr "Choisir un projet"

msgid "Choose a project for “%1”"
msgstr "Choisir un projet pour « %1 »"

msgid "Labels (Categories)"
msgstr "Étiquettes (catégories)"

msgid "Labels are extracted from Akonadi task categories. Hidden labels will not appear in the sidebar filter list but remain on tasks."
msgstr "Les étiquettes proviennent des catégories Akonadi. Les étiquettes masquées n’apparaissent pas dans la barre latérale mais restent sur les tâches."

msgid "No labels found. Labels are automatically discovered from task categories in Akonadi."
msgstr "Aucune étiquette trouvée. Elles sont découvertes automatiquement depuis les catégories Akonadi."

msgid "Auto-generated color for '%1'"
msgstr "Couleur générée automatiquement pour « %1 »"

msgid "Show this label in the sidebar filter"
msgstr "Afficher cette étiquette dans le filtre de la barre latérale"

